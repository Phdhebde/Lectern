# Copy to .env (never commit it) and adapt. Read by `docker compose` for variable
# substitution in compose.yaml.

# Profiles started by `docker compose up`: "proxy" = bundled nginx with TLS on 80/443.
# Remove it to put your own reverse proxy in front of 127.0.0.1:${LECTERN_HTTP_PORT}.
COMPOSE_PROFILES=proxy

# Public address of the academy (no trailing slash) and its host name for the proxy.
LECTERN_PUBLIC_URL=https://academy.example.com
LECTERN_HOST=academy.example.com

# Database password. Generate one: openssl rand -hex 32
# Use URL-safe characters only (letters, digits): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Image: leave unset to build from this repository (`docker compose up -d --build`),
# or set a released image from your registry (`docker compose pull`).
# LECTERN_IMAGE=registry.example.com/lectern:0.1.0

# Branding directory (logo, favicon, fonts, certificate images), mounted read-only.
# LECTERN_BRANDING_DIR=./branding

# Directory holding fullchain.pem and privkey.pem for the proxy.
# TLS_CERT_DIR=./certs

# Ports on the host.
# HTTP_PORT=80
# HTTPS_PORT=443
# LECTERN_HTTP_PORT=8080

# Backups (`docker compose run --rm backup`).
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14

# Log level.
# RUST_LOG=info,sqlx=warn
