# Copy to lectern.env (never commit it). Application secrets, passed to the Lectern
# container only. Leave a line commented out when the feature is not used: an empty
# value is not the same as an unset one.

# OIDC client secret (when [auth.oidc] is configured in lectern.toml).
# LECTERN__AUTH__OIDC__CLIENT_SECRET=

# SMTP relay: smtps://user:password@smtp.example.com:465 or smtp://host:587 (STARTTLS).
# Unset: e-mails (including sign-in links) are only written to the log.
# LECTERN__MAIL__SMTP_URL=
