# TLS reverse proxy in front of Lectern (Docker Compose, profile "proxy").
# ${LECTERN_HOST} and ${LECTERN_UPSTREAM} are substituted by the nginx image at start-up.
# Lectern serves the front-end and sets the security headers (CSP, HSTS...) itself.

# Same limits as the Kubernetes overlay: generous for the whole site, strict for sign-in.
limit_req_zone $binary_remote_addr zone=lectern_site:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=lectern_auth:10m rate=10r/m;
limit_req_status 429;

upstream lectern {
    server ${LECTERN_UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name ${LECTERN_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${LECTERN_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    server_tokens off;

    # server.max_upload_mb (50 MB) plus headroom: content packs are uploaded by admins.
    client_max_body_size 200m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;

    location /api/auth/ {
        limit_req zone=lectern_auth burst=10 nodelay;
        proxy_pass http://lectern;
    }
    location /auth/ {
        limit_req zone=lectern_auth burst=10 nodelay;
        proxy_pass http://lectern;
    }
    location / {
        limit_req zone=lectern_site burst=120 nodelay;
        proxy_pass http://lectern;
    }
}
